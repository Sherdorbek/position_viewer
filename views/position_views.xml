<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Positions: list (with the Import button) -->
    <record id="view_api_position_list" model="ir.ui.view">
        <field name="name">api.position.list</field>
        <field name="model">api.position</field>
        <field name="arch" type="xml">
            <list string="Positions" create="false" >
                <header>
                    <button name="%(position_viewer.action_position_import)d" type="action"
                            string="Import from API" class="btn-primary" display="always"/>
                </header>
                <field name="title"/>
                <field name="attribute_count"/>
                <field name="users_count"/>
                <field name="api_updated_at"/>
                <field name="imported_at"/>
            </list>
        </field>
    </record>

    <!-- Positions: detail form (read-only) -->
    <record id="view_api_position_form" model="ir.ui.view">
        <field name="name">api.position.form</field>
        <field name="model">api.position</field>
        <field name="arch" type="xml">
            <form string="Position" create="false" edit="false" >
                <header>
                    <button name="%(position_viewer.action_position_import)d" type="action"
                            string="Import / Refresh from API" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="project_number"/>
                            <field name="users_count"/>
                        </group>
                        <group>
                            <field name="api_updated_at"/>
                            <field name="imported_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attributes" name="attributes">
                            <field name="attribute_ids">
                                <list>
                                    <field name="category"/>
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="aggregate_display"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_api_position_search" model="ir.ui.view">
        <field name="name">api.position.search</field>
        <field name="model">api.position</field>
        <field name="arch" type="xml">
            <search string="Positions">
                <field name="title"/>
                <field name="description"/>
            </search>
        </field>
    </record>

    <!-- Attribute: detail (opens when a row of the attributes list is clicked) -->
    <record id="view_api_position_attribute_form" model="ir.ui.view">
        <field name="name">api.position.attribute.form</field>
        <field name="model">api.position.attribute</field>
        <field name="arch" type="xml">
            <form string="Attribute" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="Attribute">
                            <field name="name"/>
                            <field name="category"/>
                            <field name="type"/>
                            <field name="options" invisible="not options"/>
                            <field name="description" invisible="not description"/>
                        </group>
                        <group string="Aggregated result">
                            <field name="agg_popular" invisible="not agg_popular"/>
                            <field name="agg_min" invisible="not agg_min"/>
                            <field name="agg_max" invisible="not agg_max"/>
                            <field name="agg_avg" invisible="not agg_avg"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_api_position" model="ir.actions.act_window">
        <field name="name">Positions</field>
        <field name="res_model">api.position</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
