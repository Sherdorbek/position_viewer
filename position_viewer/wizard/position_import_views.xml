<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_position_import_form" model="ir.ui.view">
        <field name="name">position.import.form</field>
        <field name="model">position.import</field>
        <field name="arch" type="xml">
            <form string="Import Position from API">
                <group>
                    <field name="access_token" password="True" required="1" placeholder="Paste your API token"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_position_import" model="ir.actions.act_window">
        <field name="name">Import from API</field>
        <field name="res_model">position.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
